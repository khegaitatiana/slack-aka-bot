# Humaans (Personal Access Token) — required
HUMAANS_API_KEY=your-access-token

# Slack workspace subdomain — used to build profile URLs
# (e.g. for https://manychat.slack.com/team/U01... use "manychat")
SLACK_WORKSPACE=manychat

# Slack users dump (the response from users.list API)
# Default: ./data/slack_users.json. Format: { "members": [...] } or [...].
SLACK_USERS_FILE=./data/slack_users.json

# Local web UI port
PORT=3000

# Nicknames dictionary
NICKNAME_FILE_PATH=./data/names.json

# --- Optional: only if you ever run `npm run bot` (the original Slack bot) ---
SLACK_APP_TOKEN=xapp-1-...
SLACK_BOT_TOKEN=xoxb-...
HUMAANS_SYNC_INTERVAL=60
